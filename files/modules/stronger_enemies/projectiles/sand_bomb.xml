	<Base file="data/entities/base_projectile_physics.xml">
		<PhysicsImageShapeComponent 
			image_file="mods/noita.hardmod/files/modules/stronger_enemies/gfx/sand_bomb.png"
			material="bone_box2d"
		></PhysicsImageShapeComponent>

		<ProjectileComponent
			_enabled="1"
			damage="0"
			lifetime="50"
			speed_min="80.0"
			speed_max="100.0"
			on_collision_die="1"
			on_death_explode="1"
			on_lifetime_out_explode="1"
			on_death_gfx_leave_sprite="0"
			collide_with_entities="1"
			explosion_dont_damage_shooter="0"
			do_moveto_update="1"
		>
			<config_explosion
				never_cache="0" 
				camera_shake="0" 
				explosion_radius="1" 
				explosion_sprite=""
				load_this_entity="mods/noita.hardmod/files/modules/stronger_enemies/projectiles/sand_bomb_explosion.xml"
				damage="0"
				explosion_sprite_lifetime="0" 
				create_cell_probability="0"
				hole_destroy_liquid="0"
				max_durability_to_destroy="0"
				hole_enabled="0" 
				particle_effect="0" 
				physics_explosion_power.min="0" 
				physics_explosion_power.max="0" 
				physics_throw_enabled="0" 
				shake_vegetation="0" 
				sparks_enabled="0"
				stains_enabled="0" 
				ray_energy="0"
			></config_explosion>
		</ProjectileComponent>
	
	</Base>

