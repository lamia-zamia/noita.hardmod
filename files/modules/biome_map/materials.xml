	<Reaction probability="70"
		input_cell1="[lava]" 					input_cell2="hardmod_cursed_liquid"
		output_cell1="rock_static_cursed"		output_cell2="steam"
		blob_radius1="4"						blob_radius2="4"
		blob_restrict_to_input_material1="1"	blob_restrict_to_input_material2="1" 
		audio_fx_volume_1="100.0" >
	</Reaction>

	<Reaction probability="70"
		input_cell1="[lava]" 					input_cell2="hardmod_cursed_liquid_static"
		output_cell1="rock_static_cursed"		output_cell2="steam"
		blob_radius1="4"						blob_radius2="4"
		blob_restrict_to_input_material1="1" 	blob_restrict_to_input_material2="1" 
