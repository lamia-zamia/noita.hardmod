local filename = "split.run_lua"
local path = arg[0]:sub(1, -(#filename + 1)):gsub("\\", "/")

local function lock()
	while true do end
end

local translations = {
	["key"] = {},

	--Standard langs
	["en"] = {},
	["ru"] = {},
	["pt-br"] = {},
	["es-es"] = {},
	["de"] = {},
	["fr-fr"] = {},
	["it"] = {},
	["pl"] = {},
	["zh-cn"] = {},
	["jp"] = {},
	["ko"] = {},

	--Non-Standard langs
	["tr-tr"] = {},
}

local maintained_languages = {
	["ru"] = true,
}

local standard_langs_ordered = {
	"en",
	"ru",
	"pt-br",
	"es-es",
	"de",
	"fr-fr",
	"it",
	"pl",
	"zh-cn",
	"jp",
	"ko"
}

local nonstandard_langs = {
	["tr-tr"] = "turkish",
}

local column_order = {} --core order

local f = io.open(path .. "core.csv", "r")
if f == nil then return end

local index = f:read("*l")

do
	local start_index = 1
	local in_quotes = false
	for i = 1, #index do
		local char = index:sub(i, i)

		-- Handle quoted fields
		if char == '"' then
			in_quotes = not in_quotes
		elseif char == "," and not in_quotes then
			-- End of a field
			local str = index:sub(start_index, i - 1)
			if translations[str] then column_order[#column_order+1] = str end
			start_index = i + 1
		end
	end
end

local new_core = index.."\n"
local function update_core(line)

	if line:sub(1,1) == ',' then new_core = new_core..line.."\n" return end


	local current_column = 1
	local start_index = 1
	local in_quotes = false

	for i = 1, #line do
		local char = line:sub(i, i)

		if char == '"' then
			in_quotes = not in_quotes --Handle quoted fields
		elseif char == "," and not in_quotes then

			local target = column_order[current_column]
			local str = line:sub(start_index, i - 1)
			if #str == 0 and maintained_languages[target] then
				str = column_order[current_column]:upper().."_MISSING"
			end
			new_core = new_core..str..","

			current_column = current_column + 1
			start_index = i + 1
		end
	end
	new_core = new_core..line:sub(start_index, #line).. "\n"
end


local function transcribe_line(line)
	if line:sub(1,1) == ',' then return end


	local current_column = 1
	local start_index = 1
	local in_quotes = false

	for i = 1, #line do
		local char = line:sub(i, i)

		if char == '"' then
			in_quotes = not in_quotes --Handle quoted fields
		elseif char == "," and not in_quotes then
			if current_column == #column_order then return end

			local lang_key = column_order[current_column]
			local target = translations[lang_key]
			local str = line:sub(start_index, i - 1)
			if str:sub(1, -9) == lang_key:upper() and str:sub(-8, -1) == "_MISSING" then str = "" end

			if target then target[#target+1] = str end

			current_column = current_column + 1
			start_index = i + 1 --thank you lamia for the csv parsing logic
		end
	end
end

new_core = new_core..f:read("*l").."\n" --discard second line
local n = 1
while true do
	local line =  f:read("*l")
	if line == nil then break end

	update_core(line)
	transcribe_line(line)
	n = n + 1
end
f:close()

local nc = io.open(path.."core.csv","w") --update core.csv
if nc then
	nc:write(new_core)
	nc:close()
end
--io.open(path.."core.csv", "w"):write(new_core):close()

for _,value in ipairs(translations["en"]) do
	print(tostring(value))
end

local standard = ""
for i, key in ipairs(translations["key"]) do
	if translations["en"] == nil then print("MISSING EN STRING!") lock() end

	local line = key
	for _, value in ipairs(standard_langs_ordered) do
		line = line ..","..(translations[value][i] or "")
	end
	standard = standard .. line .. ",,,\n"
end

local standard_file = io.open(path .. "standard.csv","w")
if standard_file == nil then return end
standard_file:write(standard)
standard_file:close()

for lang,name in pairs(nonstandard_langs) do
	local translation = ""
	for i, key in ipairs(translations["key"]) do
		local tl = translations[lang][i]
		if #tl == 0 then tl = translations["en"][i] end
		local line = key .. ","..tl
		translation = translation .. line .. ",,,,,,,,,,,,,\n"
	end


	local nonstandard_file = io.open(path .. name .. ".csv","w")
	if nonstandard_file then
		nonstandard_file:write(translation)
		nonstandard_file:close()
	end
end

--lock()